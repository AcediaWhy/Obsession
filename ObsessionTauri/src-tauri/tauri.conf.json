{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsession",
  "version": "1.1.0",
  "identifier": "com.vlarpsu.obsession",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Obsession",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#0A0B10",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/bin": "bin",
      "resources/configs": "configs",
      "resources/lists": "lists",
      "resources/icons": "icons",
      "resources/ranking.json": "ranking.json"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
