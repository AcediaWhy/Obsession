From 759d186c984d839c60450abe314c3a8cd813f519 Mon Sep 17 00:00:00 2001
From: Obsession Patch Builder <patches@obsession.local>
Date: Sat, 22 Aug 2026 01:09:25 +0400
Subject: [PATCH] security: harden nested IP length dissection

---
 nfq2/darkmagic.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/nfq2/darkmagic.c b/nfq2/darkmagic.c
index ff32a60..6f3d563 100644
--- a/nfq2/darkmagic.c
+++ b/nfq2/darkmagic.c
@@ -388,7 +388,17 @@ bool proto_check_ipv4_payload(const uint8_t *data, size_t len)
 // move to transport protocol
 void proto_skip_ipv4(const uint8_t **data, size_t *len, bool *frag, uint16_t *frag_off)
 {
+	if (*len < sizeof(struct ip))
+	{
+		*len = 0;
+		return;
+	}
 	uint8_t off = ((struct ip*)*data)->ip_hl << 2;
+	if (*len < off)
+	{
+		*len = 0;
+		return;
+	}
 	if (frag_off) *frag_off = (ntohs(((struct ip*)*data)->ip_off) & IP_OFFMASK) << 3;
 	if (frag) *frag = ntohs(((struct ip*)*data)->ip_off) & (IP_OFFMASK|IP_MF);
 	*data += off;
@@ -451,6 +461,11 @@ void proto_skip_ipv6(const uint8_t **data, size_t *len, uint8_t *proto_type, boo
 	if (proto_type) *proto_type = 0; // put error in advance
 	if (frag) *frag = false;
 	if (frag_off) *frag_off = 0;
+	if (*len < sizeof(struct ip6_hdr))
+	{
+		*len = 0;
+		return;
+	}
 
 	HeaderType = ip6->ip6_nxt;
 	if (proto_type) *proto_type = HeaderType;
