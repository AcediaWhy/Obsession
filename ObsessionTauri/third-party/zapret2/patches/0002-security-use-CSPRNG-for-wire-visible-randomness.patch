+static bool apply_random_badsum(uint16_t *checksum)
+{
+	uint32_t rnd;
+	if (!crypto_random_u32_bounded(0xFFFF, &rnd)) return false;
+	*checksum ^= (uint16_t)(rnd + 1);
+	return true;
+}
+
 // last_proto = IPPROTO_NONE means auto detect
 bool lua_reconstruct_dissect(lua_State *L, int idx, uint8_t *buf, size_t *len, bool keepsum, bool badsum, uint8_t last_proto, bool ip6_preserve_next)
 {
@@ -2589,7 +2597,7 @@ bool lua_reconstruct_dissect(lua_State *L, int idx, uint8_t *buf, size_t *len, b
 			if (tcp)
 			{
 				tcp_fix_checksum(tcp,l-l3,ip,ip6);
-				if (badsum) tcp->th_sum ^= 1 + (random() % 0xFFFF);
+				if (badsum && !apply_random_badsum(&tcp->th_sum)) goto err;
 			}
 			else if (udp)
 			{
@@ -2601,12 +2609,12 @@ bool lua_reconstruct_dissect(lua_State *L, int idx, uint8_t *buf, size_t *len, b
 				}
 				udp->uh_ulen = htons((uint16_t)sz);
 				udp_fix_checksum(udp,l-l3,ip,ip6);
-				if (badsum) udp->uh_sum ^= 1 + (random() % 0xFFFF);
+				if (badsum && !apply_random_badsum(&udp->uh_sum)) goto err;
 			}
 			else if (icmp)
 			{
 				icmp_fix_checksum(icmp,l-l3,ip6);
-				if (badsum) icmp->icmp_cksum ^= 1 + (random() % 0xFFFF);
+				if (badsum && !apply_random_badsum(&icmp->icmp_cksum)) goto err;
 			}
 		}
 
