From: Obsession Patch Builder <patches@obsession.local>
Date: Sat, 22 Aug 2026 01:12:20 +0400
Subject: [PATCH 2/5] security: use CSPRNG for wire-visible randomness

---
 nfq2/helpers.c  | 51 ++++++++++++++++++++++++++++++++-----------------
 nfq2/helpers.h  |  7 ++++---
 nfq2/lua.c      | 20 +++++++++++++------
 nfq2/nfqws.c    |  6 +++++-
 nfq2/protocol.c | 34 ++++++++++++++++++++++++++-------
 5 files changed, 83 insertions(+), 35 deletions(-)

diff --git a/nfq2/helpers.c b/nfq2/helpers.c
index 2b7adb7..1919ac0 100644
--- a/nfq2/helpers.c
+++ b/nfq2/helpers.c
@@ -452,32 +452,34 @@ bool file_open_test(const char *filename, int flags)
 }
 
 
-void fill_random_bytes(uint8_t *p, size_t sz)
+bool fill_random_bytes(uint8_t *p, size_t sz)
 {
-	size_t k;
-	if (sz)
-	{
-		// alignment
-		if ((size_t)p & 1) { *p = (uint8_t)random(); sz--; p++; }
-		// random has only 31 bits of entropy. not 32 bits
-		for (k = 0; (k + 1) < sz; k += 2) *(uint16_t*)(p + k) = (uint16_t)random();
-		if (sz & 1) p[sz - 1] = (uint8_t)random();
-	}
-}
-void fill_random_az(uint8_t *p, size_t sz)
-{
-	size_t k;
-	for (k = 0; k < sz; k++) p[k] = 'a' + (random() % ('z' - 'a' + 1));
+	return fill_crypto_random_bytes(p, sz);
 }
-void fill_random_az09(uint8_t *p, size_t sz)
+static bool fill_random_charset(uint8_t *p, size_t sz, const uint8_t *charset, uint8_t charset_size)
 {
 	size_t k;
 	uint8_t rnd;
+	uint16_t limit = 256 - (256 % charset_size);
 	for (k = 0; k < sz; k++)
 	{
-		rnd = random() % (10 + 'z' - 'a' + 1);
-		p[k] = rnd < 10 ? rnd + '0' : 'a' + rnd - 10;
+		do
+		{
+			if (!fill_crypto_random_bytes(&rnd, sizeof(rnd))) return false;
+		} while (rnd >= limit);
+		p[k] = charset[rnd % charset_size];
 	}
+	return true;
+}
+bool fill_random_az(uint8_t *p, size_t sz)
+{
+	static const uint8_t charset[] = "abcdefghijklmnopqrstuvwxyz";
+	return fill_random_charset(p, sz, charset, sizeof(charset) - 1);
+}
+bool fill_random_az09(uint8_t *p, size_t sz)
+{
+	static const uint8_t charset[] = "0123456789abcdefghijklmnopqrstuvwxyz";
+	return fill_random_charset(p, sz, charset, sizeof(charset) - 1);
 }
 #if defined(__FreeBSD__) && __FreeBSD_version <= 1200000
 #include <sys/sysctl.h>
@@ -602,6 +604,19 @@ bool fill_crypto_random_bytes(uint8_t *p, size_t sz)
 	return !sz;
 }
 
+bool crypto_random_u32_bounded(uint32_t upper_bound, uint32_t *value)
+{
+	uint32_t rnd, threshold;
+	if (!upper_bound || !value) return false;
+	threshold = (uint32_t)(-upper_bound) % upper_bound;
+	do
+	{
+		if (!fill_crypto_random_bytes((uint8_t*)&rnd, sizeof(rnd))) return false;
+	} while (rnd < threshold);
+	*value = rnd % upper_bound;
+	return true;
+}
+
 #if defined(__GNUC__) && !defined(__llvm__)
 __attribute__((optimize("no-strict-aliasing")))
 #endif
